# ============================================================
# ElleBeeLuxeBeads — Environment Configuration
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to ".env"
#   2. Fill in your actual credentials below
#   3. NEVER commit .env to version control
# ============================================================

# --- Server ---
PORT=3001
NODE_ENV=development

# --- JWT Authentication ---
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-this-with-a-very-long-random-secret-string

# JWT token expiry (e.g. 1d, 12h, 7d)
JWT_EXPIRES_IN=1d

# --- Admin Account (used by seed.js to create first admin) ---
ADMIN_EMAIL=admin@ellabeeluxebeads.com
ADMIN_PASSWORD=change-this-password-immediately

# --- Cloudinary (Image Storage) ---
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=ellabeeluxebeads

# --- Database ---
# SQLite — file path (relative to project root)
DB_PATH=./server/ellabeeluxebeads.db

# --- WhatsApp (override default in settings) ---
DEFAULT_WHATSAPP_NUMBER=2349031382368

# --- CORS --- 
# Comma-separated list of allowed origins (for production)
# In development, all origins are allowed
ALLOWED_ORIGINS=http://localhost:3001
